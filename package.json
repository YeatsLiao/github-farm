{
  "name": "github-farm",
  "version": "0.1.0",
  "description": "Grow a pixel-art farm from a GitHub repository's stars",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:star-farm": "node scripts/render-farm.mjs",
    "test": "cd test && node --test",
    "test:star-farm": "npm test",
    "preview:star-farm": "node scripts/preview-farms.mjs",
    "serve:star-farm": "node scripts/serve-farm.mjs",
    "art:star-farm": "node scripts/build-atlas.mjs"
  },
  "keywords": [
    "github",
    "stars",
    "visualization",
    "pixel-art",
    "stardew-valley",
    "farm"
  ],
  "author": "YeatsLiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YeatsLiao/github-farm.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
