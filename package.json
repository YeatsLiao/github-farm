{
  "name": "github-farm",
  "version": "0.1.0",
  "description": "Grow a pixel-art farm from a GitHub repository's stars",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:star-farm": "node scripts/render/render-starter-farm.mjs",
    "test": "cd test && node --test",
    "test:star-farm": "npm test",
    "preview:star-farm": "node scripts/render/preview-farm-themes.mjs",
    "serve:star-farm": "node src/http/start-star-farm.js",
    "art:star-farm": "node scripts/art/build-star-spring.mjs",
    "legacy:dev": "node archive/contribution-farm/dev-server.mjs",
    "legacy:build": "node archive/contribution-farm/src/index.js --mock",
    "legacy:test": "node --test archive/contribution-farm/test/living-farm.test.js",
    "prototype:test": "node --test archive/star-farm-prototype/blueprint.test.js",
    "prototype:samples": "node archive/star-farm-prototype/render-samples.mjs"
  },
  "keywords": [
    "github",
    "stars",
    "visualization",
    "pixel-art",
    "stardew-valley",
    "farm"
  ],
  "author": "YeatsLiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YeatsLiao/github-farm.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
